# Copiar como .env en la raíz del repositorio y completar. Nunca subir .env al repositorio.
# Lo usa docker compose. Para ejecutar sin Docker, ver backend/.env.example y frontend/.env.example.

# PostgreSQL
DB_NAME=trekia
DB_USER=postgres
DB_PASSWORD=
DB_PORT_HOST=5433

# JWT: cadena aleatoria de al menos 32 caracteres
# (por ejemplo: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))")
JWT_SECRET=
JWT_EXPIRES_IN=2h
BCRYPT_ROUNDS=12

# Puertos publicados en el computador
BACKEND_PORT=3000
FRONTEND_PORT=8080

# Dirección de la API que usa el navegador (se incrusta al construir el frontend)
VITE_API_URL=http://localhost:3000/api

# Orígenes permitidos por CORS: debe incluir la dirección del frontend
CORS_ORIGINS=http://localhost:8080,http://localhost:8100,http://localhost:5173

# Servicio externo del clima (Open-Meteo, no necesita API key)
CLIMA_API_URL=https://api.open-meteo.com/v1/forecast
CLIMA_TIMEOUT_MS=5000
CLIMA_CACHE_MINUTOS=30
