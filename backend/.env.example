# Copiar como .env y completar. Nunca subir .env al repositorio.

PORT=3000
NODE_ENV=development

# PostgreSQL
DB_HOST=localhost
DB_PORT=5432
DB_NAME=trekia
DB_USER=
DB_PASSWORD=

# JWT: cadena aleatoria de al menos 32 caracteres
# (por ejemplo: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))")
JWT_SECRET=
JWT_EXPIRES_IN=2h

# Costo de bcrypt (10-12 recomendado)
BCRYPT_ROUNDS=12

# Orígenes permitidos, separados por coma:
# ionic serve (8100), vite (5173), Capacitor iOS (capacitor://localhost, ionic://localhost)
# y Capacitor Android (http://localhost / https://localhost)
CORS_ORIGINS=http://localhost:8100,http://localhost:5173,capacitor://localhost,ionic://localhost,http://localhost,https://localhost
